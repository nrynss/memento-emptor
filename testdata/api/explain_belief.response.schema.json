{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memento-emptor.local/testdata/api/explain_belief.response.schema.json",
  "title": "explain_belief response",
  "description": "Every piece of evidence with its reason, every correction, and the history in order.",
  "type": "object",
  "required": ["belief", "corrections", "timeline"],
  "additionalProperties": false,
  "properties": {
    "belief": {"$ref": "common.schema.json#/$defs/Belief"},
    "corrections": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/Correction"}},
    "timeline": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/TimelineEvent"}}
  }
}
