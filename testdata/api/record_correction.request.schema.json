{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memento-emptor.local/testdata/api/record_correction.request.schema.json",
  "title": "record_correction request",
  "description": "The shopper's explicit correction, declared against the belief it contradicts. The contradicted belief id is required.",
  "type": "object",
  "required": ["shopper_id", "text", "contradicts_belief_id"],
  "additionalProperties": false,
  "properties": {
    "shopper_id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "contradicts_belief_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1}
  }
}
