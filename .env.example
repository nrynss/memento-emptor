# The variables the code reads. Values live in the system keyring, never in a
# file. `source tools/env.sh` exports each one from the keyring, under the name
# below. This file holds no value and is safe to commit.
#
# The PayPal sandbox site logins are also in the keyring, for a person signing
# in to the sandbox. No code reads them, so they are not variables here.

# PayPal Developer sandbox app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Channel3 product data.
CHANNEL3_API_KEY=

# OpenRouter, which is how Jev is called.
OPENROUTER_API_KEY=

# Elastic deployment, also Lambo's recall tier.
LAMBO_ES_API_KEY=
ELASTIC_URL=

# Render, for the hosted demo and the PayPal webhook endpoint.
RENDER_API_KEY=

# The identity salt, 32 bytes as 64 hex characters. It keys the shopper's
# session name and the per-line shopper hash; rotating it orphans existing
# sessions and breaks opt-out's recompute. Seeded rows use the published seed
# salt in internal/identity instead.
MEMENTO_IDENTITY_SALT=

# Caller keys for the layer's authenticated routes. Each holds zero or more
# whitespace-separated entries of id|sha256|seller|shoppers|flags, minted by
# `memento key issue` (internal/auth) and stored in the keyring under service
# memento-keys, kinds agent, shopper and merchant. The deployment keeps only
# the entries; each token is handed to its caller once and never stored.
MEMENTO_AGENT_KEYS=
MEMENTO_SHOPPER_TOKENS=
MEMENTO_MERCHANT_KEYS=
